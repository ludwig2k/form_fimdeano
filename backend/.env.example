# Segredo usado para assinar os tokens JWT (login) e os links de reenvio de comprovante.
# Gere um valor aleatório forte em produção, ex: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=troque-este-valor-em-producao

# Credenciais das duas contas internas (compartilhadas por função), criadas automaticamente no primeiro start.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=troque-esta-senha
CHECKIN_USERNAME=checkin
CHECKIN_PASSWORD=troque-esta-senha

# Banco SQLite (caminho do arquivo)
DATABASE_URL=sqlite:///./data/confra.db

# Pasta onde os comprovantes de pagamento são salvos
UPLOAD_DIR=./uploads

# URL pública do site (usada para montar o link de reenvio de comprovante no e-mail de rejeicao,
# e liberada no CORS). Em dev local, use a porta do "npm run dev" do frontend.
PUBLIC_BASE_URL=http://localhost:37230

# SMTP institucional. Se deixar em branco, os e-mails são apenas logados no console (modo dev).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
EMAIL_FROM=confraternizacao@sead.go.gov.br

# Dados do evento exibidos no e-mail/QR de pagamento
EVENTO_VALOR_INSCRICAO=0,00
