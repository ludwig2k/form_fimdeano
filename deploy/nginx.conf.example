# Config de exemplo para o Nginx na VPS. Ajuste "confra.seudominio.com.br" para o
# dominio/subdominio real e coloque este arquivo em /etc/nginx/sites-available/confra,
# depois: sudo ln -s /etc/nginx/sites-available/confra /etc/nginx/sites-enabled/
#
# Depois de habilitar, rode `sudo certbot --nginx -d confra.seudominio.com.br` para
# emitir o certificado HTTPS automaticamente (ele reescreve este arquivo adicionando
# o bloco de SSL e o redirect http->https).

server {
    listen 80;
    server_name confra.seudominio.com.br;

    # Comprovantes podem ir ate 5MB (mesmo limite validado no backend).
    client_max_body_size 6M;

    location / {
        proxy_pass http://127.0.0.1:33269;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
